# Copy to .env and adjust. Never commit .env.

# Host port for http://localhost:<HOST_PORT>
HOST_PORT=7007

# dev        = password-less local login page (for testing on this machine)
# cloudflare = trust only Cloudflare Access JWTs (use once the tunnel + Access app exist)
AUTH_MODE=dev

# Signs the dev-login cookie. Leave empty to have the server generate one and save it in
# the data folder (so restarts keep you logged in), or generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Google Gemini key for AI card scanning (https://aistudio.google.com/apikey).
# `npm run share` asks for it when empty. Only the server uses it; phones never see it.
GEMINI_API_KEY=
# Default model; players can pick another from the models the key has access to.
GEMINI_MODEL=gemini-3.5-flash-lite

# Emails that get role "admin" (comma-separated). Ignored while AUTH_MODE=dev, because the dev
# login page has no password and `npm run share` makes it public. DEV_ALLOW_ADMINS=true overrides
# that; only use it on a server nobody else can reach.
ADMIN_EMAILS=you@example.com

# true (default) = non-admins can't write GameRoom/Player/RoundScore through /api/entities, and
# generic reads must name a room they belong to. The app uses the game actions instead.
LOCK_GAME_ENTITIES=true

# Rooms nobody has touched for this many hours are deleted, unless a player is online.
# 0 keeps rooms forever.
STALE_ROOM_HOURS=24

# --- Cloudflare (fill in during the tunnel step) ---
# Zero Trust team domain, e.g. yourteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag from the Access application overview
CF_ACCESS_AUD=
# Tunnel token from Zero Trust > Networks > Tunnels
TUNNEL_TOKEN=
