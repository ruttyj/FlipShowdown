# Image for the `dev` compose service (`npm run share`). The source folder is mounted at
# /workspace at runtime, so nothing is copied in here; dependencies are installed on start
# by scripts/dev-container.sh into Docker volumes.
FROM node:22-bookworm-slim

# Build tools in case better-sqlite3 has no prebuilt binary for this platform.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
CMD ["sh", "scripts/dev-container.sh"]
