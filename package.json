{
  "name": "flip-showdown",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "build:launcher": "vite build --config desktop/vite.config.js",
    "screenshots": "node scripts/screenshots.mjs",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "typecheck": "tsc -p ./jsconfig.json && tsc -p ./desktop/jsconfig.json",
    "preview": "vite preview",
    "test": "node --test tests/",
    "test:ui": "vitest run",
    "test:e2e": "playwright test",
    "test:desktop": "npm --prefix desktop test",
    "test:all": "npm test && npm run test:ui && npm --prefix server test && npm run test:desktop",
    "coverage": "npm run coverage:node && npm run coverage:ui && npm run coverage:merge",
    "coverage:node": "c8 --all --include=\"src/**\" --include=\"shared/**\" --include=\"desktop/src/main/**\" --exclude=\"desktop/src/main/main.js\" --exclude=\"src/components/ui/**\" --exclude=\"src/lib/utils.js\" --exclude=\"src/hooks/use-mobile.jsx\" --exclude=\"src/utils/**\" --exclude=\"src/types/**\" --exclude=\"src/main.jsx\" --reports-dir=coverage/node --reporter=lcov --reporter=text-summary node --test tests/ desktop/test/",
    "coverage:ui": "vitest run --coverage",
    "coverage:merge": "node scripts/merge-coverage.mjs --areas client --out coverage/merged coverage/node/lcov.info coverage/ui/lcov.info",
    "start": "docker compose --profile share stop dev quicktunnel && docker compose up -d --build --wait app",
    "share": "node scripts/share.mjs",
    "fetch:cloudflared": "node scripts/fetch-cloudflared.mjs",
    "stop": "docker compose --profile share down",
    "backup": "npm --prefix server run backup",
    "desktop": "npm run build && npm run build:launcher && npm run fetch:cloudflared && npm --prefix desktop run stage && npm --prefix desktop start"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^17.0.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-aspect-ratio": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-hover-card": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-navigation-menu": "^1.2.5",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-query": "^5.84.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.5.2",
    "emoji-picker-react": "^4.22.3",
    "framer-motion": "^11.16.4",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.475.0",
    "next-themes": "^0.4.4",
    "qrcode": "^1.5.3",
    "react": "^18.2.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.54.2",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "^7.18.5",
    "recharts": "^2.15.4",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.13.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.4.20",
    "baseline-browser-mapping": "^2.8.32",
    "c8": "^12.0.0",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.1.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "test-exclude": {
      "glob": "^14.0.5",
      "minimatch": "^11.0.5"
    }
  }
}
